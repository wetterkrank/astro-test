---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n/locales';
import type { Alternates } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  alternates?: Alternates;
}

const { title, description, locale, alternates } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternates={alternates}
  styles={['utility/tachyons.css']}
>
  <main class="page-main flex items-center justify-center" id="main-content" tabindex="-1">
    <slot />
  </main>
</BaseLayout>
