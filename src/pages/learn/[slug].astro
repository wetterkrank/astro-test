---
import { render } from 'astro:content';
import LearnArticleLayout from '../../layouts/LearnArticleLayout.astro';
import { getEntriesForLocale, splitLocaleId } from '../../i18n/content';

// English-only for now; other locales get their own route when translated.
const locale = 'en';

export async function getStaticPaths() {
  const articles = await getEntriesForLocale('learn', 'en');
  return articles.map((entry) => ({
    params: { slug: splitLocaleId(entry.id).slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<LearnArticleLayout article={entry.data} locale={locale}>
  <Content />
</LearnArticleLayout>
